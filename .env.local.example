# --- Supabase ---
# Project URL (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Resend ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# The "from" address. Must be on a domain you've verified in Resend.
BOOKING_FROM_EMAIL=bookings@yourdomain.com
# Where the artist receives new-booking notifications.
ARTIST_EMAIL=artist@yourdomain.com
